{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Highlight timeline",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide", "events"],
        "properties": {
          "slide": {"type": "integer"},
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {"enum": ["knowledge", "code", "algorithm"]},
                "label": {"type": "string"},
                "target_text": {"type": "string"},
                "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "line_count": {"type": "integer", "minimum": 1, "maximum": 30}
              }
            }
          }
        }
      }
    }
  }
}
