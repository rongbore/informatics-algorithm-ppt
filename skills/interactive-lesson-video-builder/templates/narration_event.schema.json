{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narration events",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "schema_version": {"type": "string"},
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slide", "events"],
        "properties": {
          "slide": {"type": "integer", "minimum": 1},
          "slide_end_pause_seconds": {"type": "number", "minimum": 0},
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "text"],
              "properties": {
                "event_id": {"type": "string"},
                "type": {"enum": ["narration", "thinking_prompt", "reveal", "summary", "pause"]},
                "text": {"type": "string"},
                "difficulty": {"enum": ["D1", "D2", "D3", "D4", "D5"]},
                "thinking_seconds": {"type": "number", "minimum": 0},
                "pause_after_seconds": {"type": "number", "minimum": 0},
                "knowledge_point_end": {"type": "boolean"},
                "duration_seconds": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
