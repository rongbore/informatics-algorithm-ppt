# Tencent Cloud credentials (never commit real values)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_VOICE_TYPE=1001
TENCENT_TTS_SPEED=0.2
TENCENT_TTS_VOLUME=0
TENCENT_TTS_EMOTION=
# Explicit free-tier-only safeguards. Keep cloud disabled until the console shows
# a remaining FREE quota and pay-as-you-go is disabled for this account/service.
TENCENT_TTS_ALLOW_FREE_TIER=false
TENCENT_TTS_POSTPAID_DISABLED=false
# Set this no higher than the verified remaining free characters in Tencent console.
TENCENT_TTS_FREE_BUDGET_CHARS=0
# Optional persistent budget ledger location; default is under the current user's home.
# TENCENT_TTS_BUDGET_STATE=
# Local offline sherpa-onnx model paths (download model separately; review its license).
SHERPA_TTS_MODEL=
SHERPA_TTS_TOKENS=
SHERPA_TTS_LEXICON=
SHERPA_TTS_RULE_FSTS=
SHERPA_TTS_SPEAKER_ID=21
SHERPA_TTS_THREADS=2
SHERPA_TTS_SPEED=1.0
