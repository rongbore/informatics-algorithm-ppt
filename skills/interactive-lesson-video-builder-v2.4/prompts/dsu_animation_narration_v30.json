{
  "schema_version": "3.0.1",
  "source_pptx": "并查集_四道随堂练习_34页课堂课件.pptx",
  "animations": [
    {
      "animation_id": "relatives",
      "title": "练习一：亲戚",
      "events": [
        {
          "event_id": "dsu_relatives_00",
          "type": "narration",
          "text": "六个人最初各自成组。关系登记只会合并集合，不会拆分集合。"
        },
        {
          "event_id": "dsu_relatives_01",
          "type": "narration",
          "text": "第一条关系，把一号和二号所在的集合合并，集合数从六变成五。"
        },
        {
          "event_id": "dsu_relatives_02",
          "type": "narration",
          "text": "第二条关系，把一号和五号所在的集合合并，集合数变成四。"
        },
        {
          "event_id": "dsu_relatives_03",
          "type": "narration",
          "text": "第三条关系，三号和四号合并，当前剩下三个集合。"
        },
        {
          "event_id": "dsu_relatives_04",
          "type": "narration",
          "text": "第四条关系，五号和二号已经通过一号连通，这次合并不改变集合数，仍然是三组。"
        },
        {
          "event_id": "dsu_relatives_05",
          "type": "narration",
          "text": "第五条关系，把一号和三号所在的集合合并，最终分成两组：一到五号，以及六号。"
        },
        {
          "event_id": "dsu_relatives_06",
          "type": "narration",
          "text": "关系读完后再回答询问。比较两个节点的根，不能只比较它们的直接父亲。"
        }
      ]
    },
    {
      "animation_id": "fencing",
      "title": "练习二：修建围栏",
      "events": [
        {
          "event_id": "dsu_fence_00",
          "type": "narration",
          "text": "先看原样例七头奶牛的真实坐标。二号和六号距离很近，但它们属于不同哞网。"
        },
        {
          "event_id": "dsu_fence_01",
          "type": "narration",
          "text": "沿第一条关系，把一号和二号所在的集合合并。"
        },
        {
          "event_id": "dsu_fence_02",
          "type": "narration",
          "text": "继续按题目给出的关系合并，三号和二号连通，第一组逐渐形成。"
        },
        {
          "event_id": "dsu_fence_03",
          "type": "narration",
          "text": "第三号与第四号连通后，第一组最终包含一、二、三、四号。"
        },
        {
          "event_id": "dsu_fence_04",
          "type": "narration",
          "text": "另一组由五、六、七号组成。关系决定分组，不能按坐标距离分组。"
        },
        {
          "event_id": "dsu_fence_05",
          "type": "narration",
          "text": "五条关系全部处理完，最终两组是 A 等于一二三四，B 等于五六七。"
        },
        {
          "event_id": "dsu_fence_06",
          "type": "narration",
          "text": "分别计算每组的最小外接矩形周长，得到四十和十，取较小值，答案是十。"
        }
      ]
    },
    {
      "animation_id": "food_chain",
      "title": "练习三：食物链",
      "events": [
        {
          "event_id": "dsu_food_00",
          "type": "narration",
          "text": "每只动物拆成三个关系槽位：本类 S、猎物类 P、天敌类 E。三列一起维护关系。"
        },
        {
          "event_id": "dsu_food_01",
          "type": "narration",
          "text": "如果 D 等于一，表示两只动物同类，需要合并本类、本类，猎物类、猎物类，以及天敌类、天敌类这三对。"
        },
        {
          "event_id": "dsu_food_02",
          "type": "narration",
          "text": "如果 D 等于二，表示 x 吃 y，需要建立 P(x) 等于 S(y)，S(x) 等于 E(y)，E(x) 等于 P(y) 这三条关系。"
        },
        {
          "event_id": "dsu_food_03",
          "type": "narration",
          "text": "接受一句话之前，先检查它是否与已经接受的关系冲突。每句话最多计为一次假话。"
        },
        {
          "event_id": "dsu_food_04",
          "type": "narration",
          "text": "回到课件第一组样例：n 等于五，检查三句话。最终 A 类是 1、2、3、5，B 类是 4，A 吃 B。三句话可以同时成立，假话数为零。"
        },
        {
          "event_id": "dsu_food_05",
          "type": "narration",
          "text": "再看课件第二组样例：n 等于三，检查两句话。变式把第一句改成 2、1、4，编号四越界；课件复算结论是假话数为一。"
        },
        {
          "event_id": "dsu_food_06",
          "type": "narration",
          "text": "最后记住：即使一句话能由已有关系推出，只要它没有矛盾，也应该接受，不能重复计为假话。"
        }
      ]
    },
    {
      "animation_id": "galaxy",
      "title": "练习四：银河英雄传说",
      "events": [
        {
          "event_id": "dsu_galaxy_00",
          "type": "narration",
          "text": "先看两支队伍：接收队伍是六、七、八，移来的队伍是一、二。每支队伍都保持原来的顺序。"
        },
        {
          "event_id": "dsu_galaxy_01",
          "type": "narration",
          "text": "执行 M 2 7，把二号所在整队接到七号所在队伍的队尾，接收队伍排在前面。"
        },
        {
          "event_id": "dsu_galaxy_02",
          "type": "narration",
          "text": "合并后队列是六、七、八、一、二，位置从零开始。船一的位置是三，船二的位置是四。"
        },
        {
          "event_id": "dsu_galaxy_03",
          "type": "narration",
          "text": "课件再单独展示路径压缩：旧父链是二指向三、三指向四，两条边的偏移都是一。"
        },
        {
          "event_id": "dsu_galaxy_04",
          "type": "narration",
          "text": "压缩后，二直接指向四，新边权为二。改变父指针不能改变船的实际位置。"
        }
      ]
    }
  ]
}