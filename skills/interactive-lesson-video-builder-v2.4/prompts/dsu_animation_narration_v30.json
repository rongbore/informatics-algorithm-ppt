  "animations": [
    {
      "animation_id": "relatives",
      "title": "练习一：亲戚",
      "events": [
        {
          "event_id": "dsu_relatives_00",
          "type": "narration",
          "text": "先看初始状态，六个人各自是一个独立集合。"
        },
        {
          "event_id": "dsu_relatives_01",
          "type": "narration",
          "text": "第一条关系，一和二合并，集合数量从六变成五。"
        },
        {
          "event_id": "dsu_relatives_02",
          "type": "narration",
          "text": "第二条关系，一和五合并，集合数量继续减少到四。"
        },
        {
          "event_id": "dsu_relatives_03",
          "type": "narration",
          "text": "第三条关系，三和四合并，现在还剩三个集合。"
        },
        {
          "event_id": "dsu_relatives_04",
          "type": "narration",
          "text": "第四条关系，五和二早已连通，所以集合数量不变。"
        },
        {
          "event_id": "dsu_relatives_05",
          "type": "narration",
          "text": "最后合并一和三，五个人进入同一个集合，只剩两个集合。"
        },
        {
          "event_id": "dsu_relatives_06",
          "type": "narration",
          "text": "查询时比较两个节点的根，而不是只比较直接父亲。"
        }
      ]
    },
    {
      "animation_id": "fencing",
      "title": "练习二：修建围栏",
      "events": [
        {
          "event_id": "dsu_fencing_00",
          "type": "narration",
          "text": "先观察七头奶牛的坐标。坐标接近，不代表它们属于同一个哞网。"
        },
        {
          "event_id": "dsu_fencing_01",
          "type": "narration",
          "text": "第一条关系，一号和二号进入同一个集合。"
        },
        {
          "event_id": "dsu_fencing_02",
          "type": "narration",
          "text": "第二条关系，二号和三号连通，三头牛属于同一组。"
        },
        {
          "event_id": "dsu_fencing_03",
          "type": "narration",
          "text": "第三条关系，三号和四号合并，第一组现在有四头牛。"
        },
        {
          "event_id": "dsu_fencing_04",
          "type": "narration",
          "text": "第四条关系，五号和六号组成第二个集合。"
        },
        {
          "event_id": "dsu_fencing_05",
          "type": "narration",
          "text": "第五条关系，七号并入第二组，最终分组是四头牛和三头牛。"
        },
        {
          "event_id": "dsu_fencing_06",
          "type": "narration",
          "text": "第一组周长四十，第二组宽二高三，周长十，因此最小答案是十。"
        }
      ]
    },
    {
      "animation_id": "food_chain",
      "title": "练习三：食物链",
      "events": [
        {
          "event_id": "dsu_food_chain_00",
          "type": "narration",
          "text": "每只动物拆成本类、猎物类和天敌类三个槽位，三列分别维护关系。"
        },
        {
          "event_id": "dsu_food_chain_01",
          "type": "narration",
          "text": "第一句，一吃二，建立三组对应关系，这句话可以接受。"
        },
        {
          "event_id": "dsu_food_chain_02",
          "type": "narration",
          "text": "第二句，二吃三，与已有关系不冲突，可以接受。"
        },
        {
          "event_id": "dsu_food_chain_03",
          "type": "narration",
          "text": "第三句，三吃一符合三类循环关系，虽然能推出，仍然是正确的话。"
        },
        {
          "event_id": "dsu_food_chain_04",
          "type": "narration",
          "text": "第四句，二吃一与已知方向冲突，计为假话。"
        },
        {
          "event_id": "dsu_food_chain_05",
          "type": "narration",
          "text": "第五句，一和三同类，与已有捕食关系冲突，再计一次假话。"
        },
        {
          "event_id": "dsu_food_chain_06",
          "type": "narration",
          "text": "第六句出现编号越界，拒绝。六句话中有三句为假。"
        }
      ]
    },
    {
      "animation_id": "galaxy",
      "title": "练习四：银河英雄传说",
      "events": [
        {
          "event_id": "dsu_galaxy_00",
          "type": "narration",
          "text": "当前有两支队伍，移来的队伍是一和二，接收队伍是六、七、八。"
        },
        {
          "event_id": "dsu_galaxy_01",
          "type": "narration",
          "text": "执行移动命令，把整队一、二接到六、七、八后面。"
        },
        {
          "event_id": "dsu_galaxy_02",
          "type": "narration",
          "text": "接收队伍原来有三艘船，所以新队首到船一的偏移是三，船二的偏移是四。"
        },
        {
          "event_id": "dsu_galaxy_03",
          "type": "narration",
          "text": "再看路径压缩例子，船二到船三、船三到船四，两条边权都是一。"
        },
        {
          "event_id": "dsu_galaxy_04",
          "type": "narration",
          "text": "压缩后船二直接指向船四，边权变成二，真实队列位置保持不变。"
        }
      ]
    }
  ]
}