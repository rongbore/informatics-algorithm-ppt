\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lesson-style}[2026/11/22 v1.3.2 C++ lesson PDF style without line numbers]
\RequirePackage[a4paper,left=22mm,right=22mm,top=20mm,bottom=21mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\setCJKmainfont[Path=/usr/share/texlive/texmf-dist/fonts/opentype/public/fandol/,Extension=.otf,BoldFont=FandolSong-Bold]{FandolSong-Regular}
\RequirePackage{xcolor}
\definecolor{LessonBlue}{HTML}{22598D}
\definecolor{LessonTeal}{HTML}{18766E}
\definecolor{LessonOrange}{HTML}{B4661D}
\definecolor{LessonBorder}{HTML}{D8E3EC}
\definecolor{LessonPale}{HTML}{F5F9FC}
\definecolor{CodeComment}{HTML}{478F88}
\definecolor{CodeKeyword}{HTML}{22598D}
\definecolor{CodeString}{HTML}{A45E36}
\RequirePackage{amsmath,amssymb}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{booktabs,tabularx,array,longtable}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=LessonBlue,urlcolor=LessonTeal}
\setlength{\parindent}{2em}
\setlength{\parskip}{3pt}
\linespread{1.26}
\setlength{\emergencystretch}{2em}
\setlist[enumerate]{leftmargin=2.6em,itemsep=2pt,topsep=4pt}
\setlist[itemize]{leftmargin=2.6em,itemsep=2pt,topsep=4pt}
\titleformat{\section}{\fontsize{14.3}{20}\bfseries\color{LessonBlue}}{}{0pt}{}
\titlespacing*{\section}{0pt}{17pt}{9pt}
\titleformat{\subsection}{\fontsize{12}{17}\bfseries\color{LessonTeal}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{13pt}{6pt}
\titleformat{\subsubsection}{\fontsize{11}{15}\bfseries\color{LessonOrange}}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{10pt}{4pt}
\newcommand{\LessonTitle}[2]{\begin{center}\vspace*{0pt}{\fontsize{24}{31}\bfseries\color{LessonBlue}#1\par}\vspace{5pt}{\fontsize{10.9}{16}\color{LessonTeal}#2\par}\end{center}\vspace{8pt}}
\newcommand{\LessonLabel}[1]{\par\medskip\noindent{\bfseries\color{LessonOrange}#1}\par\smallskip}
\newtcolorbox{lessonhint}[1][]{enhanced,breakable,colback=LessonPale,colframe=LessonBorder,boxrule=.55pt,arc=0pt,left=8pt,right=8pt,top=6pt,bottom=6pt,#1}
\lstdefinestyle{lessoncpp}{language=C++,basicstyle=\ttfamily\fontsize{9}{12}\selectfont,keywordstyle=\color{CodeKeyword}\bfseries,commentstyle=\color{CodeComment},stringstyle=\color{CodeString},numbers=none,frame=single,rulecolor=\color{LessonBorder},backgroundcolor=\color{white},breaklines=true,breakatwhitespace=true,showstringspaces=false,tabsize=4,columns=fullflexible,keepspaces=true,xleftmargin=0pt,framexleftmargin=0pt,aboveskip=8pt,belowskip=8pt}
\lstdefinestyle{lessonfragment}{style=lessoncpp,numbers=none}
\lstset{style=lessoncpp}
