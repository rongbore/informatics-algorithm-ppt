\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lesson-style}[2026/11/22 v1.3.2 clean code layout without line numbers]
\RequirePackage[a4paper,left=20mm,right=20mm,top=18mm,bottom=20mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
% Source uses FandolSong. Do NOT package font files; use system/TeX fonts.
\IfFileExists{/usr/share/texlive/texmf-dist/fonts/opentype/public/fandol/FandolSong-Regular.otf}{%
  \setCJKmainfont[Path=/usr/share/texlive/texmf-dist/fonts/opentype/public/fandol/,Extension=.otf,BoldFont=FandolSong-Bold]{FandolSong-Regular}%
  \setCJKmonofont[Path=/usr/share/texlive/texmf-dist/fonts/opentype/public/fandol/,Extension=.otf]{FandolSong-Regular}%
}{%
  \IfFontExistsTF{FandolSong-Regular}{%
    \setCJKmainfont[BoldFont=FandolSong-Bold]{FandolSong-Regular}%
    \setCJKmonofont{FandolSong-Regular}%
  }{%
    \IfFontExistsTF{SimSun}{\setCJKmainfont{SimSun}\setCJKmonofont{SimSun}}{%
      \IfFontExistsTF{Noto Serif CJK SC}{\setCJKmainfont{Noto Serif CJK SC}\setCJKmonofont{Noto Serif CJK SC}}{%
        \setCJKmainfont{FandolSong-Regular}\setCJKmonofont{FandolSong-Regular}}%
    }%
  }%
}
\IfFileExists{/usr/share/texmf/fonts/opentype/public/lm/lmroman10-regular.otf}{%
 \setmainfont[Path=/usr/share/texmf/fonts/opentype/public/lm/,Extension=.otf,BoldFont=lmroman10-bold,ItalicFont=lmroman10-italic]{lmroman10-regular}%
 \setmonofont[Path=/usr/share/texmf/fonts/opentype/public/lm/,Extension=.otf,ItalicFont=lmmono10-italic]{lmmono10-regular}%
}{%
 \IfFontExistsTF{Latin Modern Roman}{\setmainfont{Latin Modern Roman}}{\setmainfont{TeX Gyre Termes}}%
 \IfFontExistsTF{Latin Modern Mono}{\setmonofont{Latin Modern Mono}}{\setmonofont{DejaVu Sans Mono}}%
}
