\titleformat{\section}{\fontsize{14.35}{20}\bfseries\color{LessonBlue}}{}{0pt}{}
\titlespacing*{\section}{0pt}{15pt}{8pt}
\titleformat{\subsection}{\fontsize{11.96}{17}\bfseries\color{LessonTeal}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}
\titleformat{\subsubsection}{\fontsize{10.91}{16}\bfseries\color{LessonOrange}}{}{0pt}{}
