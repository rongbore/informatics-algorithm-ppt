\newcommand{\LessonTitle}[2]{\begin{center}\vspace*{-6pt}{\fontsize{23.91}{31}\bfseries\color{LessonBlue}#1\par}\vspace{5pt}{\fontsize{10.91}{16}\color{LessonTeal}#2\par}\end{center}\vspace{10pt}}
\newcommand{\LessonLabel}[1]{\Needspace{4\baselineskip}\par\smallskip\noindent{\fontsize{10.91}{16}\selectfont\bfseries\color{LessonOrange}#1}\par\smallskip}
\newcommand{\LessonMeta}[1]{\par\noindent{\fontsize{9.8}{14}\selectfont\color{LessonTeal}#1}\par\smallskip}
\newcommand{\LessonMath}[1]{\[\displaystyle #1\]}
% Source PDF uses strip-headed soft-colored boxes, not modern filled callouts.
\newtcolorbox{lessonblue}[1]{enhanced,breakable,sharp corners,colback=LessonPaleBlue,colframe=LessonBlueStripe,colbacktitle=LessonBlueStripe,coltitle=LessonBlue,title={#1},fonttitle=\bfseries\small,boxrule=.55pt,left=8pt,right=8pt,top=5pt,bottom=6pt,toptitle=3pt,bottomtitle=3pt,before skip=8pt,after skip=8pt}
\newtcolorbox{lessonteal}[1]{enhanced,breakable,sharp corners,colback=LessonPaleTeal,colframe=LessonTealStripe,colbacktitle=LessonTealStripe,coltitle=LessonTeal,title={#1},fonttitle=\bfseries\small,boxrule=.55pt,left=8pt,right=8pt,top=5pt,bottom=6pt,toptitle=3pt,bottomtitle=3pt,before skip=8pt,after skip=8pt}
\newtcolorbox{lessonorange}[1]{enhanced,breakable,sharp corners,colback=LessonPaleOrange,colframe=LessonOrangeStripe,colbacktitle=LessonOrangeStripe,coltitle=LessonOrange,title={#1},fonttitle=\bfseries\small,boxrule=.55pt,left=8pt,right=8pt,top=5pt,bottom=6pt,toptitle=3pt,bottomtitle=3pt,before skip=8pt,after skip=8pt}
\newtcolorbox{lessonred}[1]{enhanced,breakable,sharp corners,colback=LessonPaleRed,colframe=LessonRedStripe,colbacktitle=LessonRedStripe,coltitle=LessonOrange,title={#1},fonttitle=\bfseries\small,boxrule=.55pt,left=8pt,right=8pt,top=5pt,bottom=6pt,toptitle=3pt,bottomtitle=3pt,before skip=8pt,after skip=8pt}
% A Unicode-capable C++ code block. Source is the *same* standalone .cpp file tested by g++.
% XeLaTeX minted v3 can initially emit <MINTED>; always compile at least twice and validate PDF text.
\newcommand{\LessonCodeFile}[1]{%
\tcbinputlisting{
 listing file={#1},listing engine=minted,minted language=cpp,minted style=vs,
 minted options={fontsize=\footnotesize,breaklines,tabsize=4,autogobble=false},
 listing only,breakable,enhanced,sharp corners,
 colback=white,colframe=LessonLine,boxrule=.55pt,
 left=6pt,right=4pt,top=6pt,bottom=6pt,
 before skip=8pt,after skip=8pt,
 }
}
\newcommand{\LessonSourceBox}[1]{\begin{tcolorbox}[enhanced,sharp corners,colback=white,colframe=LessonLine,boxrule=.55pt,left=6pt,right=6pt,top=6pt,bottom=6pt]#1\end{tcolorbox}}
\newcommand{\LessonInputOutputStart}{\begin{tcbraster}[raster columns=2,raster equal height,raster column skip=7mm]}
\newcommand{\LessonInputOutputEnd}{\end{tcbraster}}
\newtcolorbox{lessoninput}{enhanced,sharp corners,colback=LessonPaleBlue,colframe=LessonBlueStripe,colbacktitle=LessonBlueStripe,coltitle=LessonBlue,title={输入},fonttitle=\bfseries\small,boxrule=.55pt,left=8pt,right=8pt,top=5pt,bottom=6pt}
\newtcolorbox{lessonoutput}{enhanced,sharp corners,colback=LessonPaleBlue,colframe=LessonBlueStripe,colbacktitle=LessonBlueStripe,coltitle=LessonBlue,title={输出},fonttitle=\bfseries\small,boxrule=.55pt,left=8pt,right=8pt,top=5pt,bottom=6pt}
